# ============================================================
#  api/.htaccess — Todas las peticiones a /api/... van a index.php
# ============================================================

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    # El servidor web pasa la cabecera Authorization si alguna vez se usa
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Solo index.php se puede ejecutar; config.php, config.local.php y
# config.example.php nunca se abren desde el navegador.
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<Files "index.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Allow from all
    </IfModule>
</Files>
