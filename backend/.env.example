# ============================================================
#  Configuración de Restaurante SENA
#  Copie este archivo como backend/.env y complete los valores.
#  ¡backend/.env NUNCA se sube a git!
# ============================================================

# --- Base de datos (MySQL de XAMPP) ---
DB_HOST=127.0.0.1
# XAMPP usa 3306 por defecto; revise "port=" en C:\xampp\mysql\bin\my.ini
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurante_sena

# --- Servidor ---
# Clave secreta para firmar las sesiones. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Dirección con la que los celulares abren el sistema. Va dentro de los
# códigos QR de las mesas: use la IP fija del computador servidor.
SERVER_URL=http://192.168.1.10:8000

# Ponga 1 solo si publica el sistema con HTTPS
COOKIE_SEGURA=0

# Pedir sin escanear: 1 = el comensal también puede elegir su mesa en una
# lista desde la página principal; 0 = solo escaneando el QR de la mesa.
# Los pedidos hechos sin QR llegan marcados para que el personal verifique la mesa.
PERMITIR_PEDIDO_SIN_QR=1

# --- Impuestos y propina (porcentajes) ---
IMPUESTO_NOMBRE=Impoconsumo
IMPUESTO_PCT=8
# Propina sugerida (voluntaria: el comensal puede quitarla)
PROPINA_SUGERIDA_PCT=10

# --- Datos del restaurante (aparecen en la factura) ---
RESTAURANTE_NOMBRE=Restaurante SENA
RESTAURANTE_NIT=
RESTAURANTE_DIRECCION=
